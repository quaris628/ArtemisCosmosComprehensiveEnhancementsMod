if client_id == 0:
    signal_register(signal_before_player_ship_destroyed(), player_ship_destroyed_send_comms_message, server=True)

# This handles when a player ships is destroyed
# The default is to is to truly delete it
//shared/signal/player_ship_destroyed if not get_game_setup_data().is_respawn_players_enabled
    if not is_game_in_progress():
        yield success
    
    qlog(qlog_level_info(), "is being destroyed", player_ship_id=DESTROYED_ID)
    
    # The code that emits this signal already assumes to_object(DESTROYED_ID)
    # is not None (multiple times) in a way that if it was None, then
    # we would've already crashed anyway. So there's no point checking
    # whether it's None in this code; we can safely assume it's not None.
    player_ship_object = to_space_object(DESTROYED_ID)
    
    signal_emit(signal_before_player_ship_destroyed(), data={"DESTROYING_PLAYER_SHIP_ID": DESTROYED_ID, "DESTROYING_PLAYER_SHIP_OBJECT": player_ship_object})
    
    sbs.delete_object(DESTROYED_ID)
    
    signal_emit(signal_after_player_ship_destroyed(), data={"DESTROYED_PLAYER_SHIP_ID": DESTROYED_ID})
    
    ->END

==== player_ship_destroyed_send_comms_message ====
    <all>
    % {DESTROYING_PLAYER_SHIP_OBJECT.name} has perished
    % {DESTROYING_PLAYER_SHIP_OBJECT.name} has blown up
    % lost contact with {DESTROYING_PLAYER_SHIP_OBJECT.name}
    ->END

//shared/signal/player_ship_destroyed if get_game_setup_data().is_respawn_players_enabled
    qlog(qlog_level_info(), "has been destroyed and will be respawned in 2 seconds", player_ship_id=DESTROYED_ID)
    
    GAME_STATISTICS = get_game_statistics()
    GAME_STATISTICS.record_vessel_destroyed(DESTROYED_ID)
    
    await delay_sim(2)
    so = to_object(DESTROYED_ID)

    yield success if not is_game_in_progress()
    yield fail if so is None

    qlog(qlog_level_info(), "is being respawned", player_ship_id=DESTROYED_ID)
    
    respawn_player_ship(DESTROYED_ID)
    grid_rebuild_grid_objects(DESTROYED_ID)
