
signal_register(signal_game_ended(), "gui_game_end_on_game_ended")

==== gui_game_end_on_game_ended ====
    
    GAME_SETUP_DATA = get_game_setup_data()
    GAME_STATISTICS = get_game_statistics()
    
    if client_id == 0 and is_quasi_headless_server_mode_enabled():
        ->END
    
    if GAME_STATISTICS.is_end_success():
        sbs.play_music_file(client_id, get_full_music_file_path("victory"))
    else:
        sbs.play_music_file(client_id, get_full_music_file_path("failure"))
    
    if GAME_SETUP_DATA.is_client_ready(client_id) or client_id == 0:
        # Switch gui to game end screen
        
        if client_id == 0:
            # Top tabs were disabled before showing mainscreen console
            enable_gui_top_tabs(client_id)
            gui_label_to_switch_to = gui_game_end_main
        else:
            if GAME_SETUP_DATA.is_at_least_one_ship_specific_console_selected_by_client(client_id):
                assigned_ship = GAME_SETUP_DATA.get_selected_ship(client_id)
                gui_label_to_switch_to = get_game_end_gui_label_for_ship(selected_ship.number)
            else:
                gui_label_to_switch_to = gui_game_end_main
        
        # If ending from the pause menu, the delay workaround seems necessary
        # to avoid a mast-level crash:
        # https://github.com/artemis-sbs/LegendaryMissions/issues/634
        # If ending from all ships dying, the delay workaround seems necessary
        # to avoid a hard server crash.
        # TODO diagnose this hard server crash and report it ^
        # If ending from the gamemaster command, all friendly bases being destroyed,
        # all enemies being destroyed, time running out, or a neutral zone violation,
        # then this delay workaround seems unnecessary, but it also doesn't seem to
        # cause any harm.
        # I haven't tested ending from peacetime's ambassador being killed.
        gui_switch_to(gui_label_to_switch_to, delay_reroute_workaround=True)
    
    ->END

==== gui_game_end_main ====
    
    if not ensure_on_gui_task(gui_game_end_main):
        ->END
    
    GAME_STATISTICS = get_game_statistics()
    GAME_SETUP_DATA = get_game_setup_data()
    
    create_skybox_background_on_client(client_id)
    
    create_top_banner(GAME_SETUP_DATA.difficulty, GAME_SETUP_DATA.get_map_display_name())
    
    # ----- tabs -----
    
    gui_create_top_tabs("main", get_game_results_top_tabs(), x_left_px=0, y_top_px=180)
    
    # ----- main section-----
    
    # 216px = 180px from top banner + 36px from tabs
    gui_section(style=f"area:0,216px,100,100-61px;")
    
    #gui_row()
    
    # ----- left body -----
    
    with gui_sub_section(style=f"padding:10px,10px,5px,5px;background:{color_background()};"):
        
        remaining_enemies = GAME_STATISTICS.get_remaining_enemies()
        if 0 < remaining_enemies:
            create_label_value_pair("Enemies Remaining", str(remaining_enemies), "yellow")
        if 0 < GAME_STATISTICS.get_destroyed_count():
            gui_row(style="row-height:32px;padding:8px,4px,8px,0;")
            # $text is necessary in order to display a colon
            # https://github.com/artemis-sbs/LegendaryMissions/issues/566#issuecomment-4291760757
            gui_text("$text:Vessels Destroyed:;", style="font:gui-3;justify:right;color:yellow;")
            ~~
            for origin, destroyed_count in GAME_STATISTICS.get_origin_destroyed_counts_iterable():
                if 0 < destroyed_count:
                    # TODO Make origin's display string more properly configurable
                    if origin == "tsn":
                        origin_display_string = "TSN"
                    else:
                        origin_display_string = origin.capitalize()
                    create_label_value_pair(origin_display_string, str(destroyed_count), "yellow")
            ~~
    
    # ----- right body -----
    
    with gui_sub_section(style=f"padding:5px,10px,10px,5px;background:{color_background()};"):
    
        create_label_value_pair("Player Ships Lost", str(GAME_STATISTICS.get_player_ships_destroyed_count()), "lime")
        create_label_value_pair("Player Single-seat Craft Lost", str(GAME_STATISTICS.get_friendly_single_seat_destroyed_count()), "lime")
        create_label_value_pair("Friendly Stations Lost", str(GAME_STATISTICS.get_friendly_stations_destroyed_count()), "lime")
        # TODO don't hardcode/assume tsn is equivalent to friendly
        create_label_value_pair("Friendly Ships Lost", str(GAME_STATISTICS.get_origin_destroyed_count("tsn")), "lime")
        create_label_value_pair("Surrendered Ships Killed", str(GAME_STATISTICS.get_surrendered_killed_count()), "lime")
        
        # Artemis 2.8 also displays a count of space monsters tagged,
        # but 1) tags aren't implemented in Cosmos yet,
        # 2) space monsters aren't fully fleshed out in Cosmos yet, and
        # 3) this count just doesn't seem very important to me anyway,
        # so I figure it's not worth implementing (probably ever).
        
        create_label_value_pair("Ships Surrendered", str(GAME_STATISTICS.get_surrendered_count()), "yellow")
        create_label_value_pair("Player Beams Fired", str(GAME_STATISTICS.get_player_beams_fired_count()), "yellow")
        # TODO count player ordinance firing, once mast hook for the engine event gets implemented
        # https://github.com/artemis-sbs/LegendaryMissions/issues/385
        #create_label_value_pair("Player Ordinance Fired", str(GAME_STATISTICS.get_player_ordinance_fired_count()), "yellow")
        
        create_label_value_pair("Successful Dock Attempts", str(GAME_STATISTICS.get_player_successful_docks_count()), "white")
        create_label_value_pair("Anomalies Collected", str(GAME_STATISTICS.get_player_picked_up_anomaly_count()), "white")
        # TODO count mines detonated
        # I don't think it's possible to detect whether damage was from a mine
        # from code triggered by //damage/object but maybe this will change
        # if this inconsistent damage parent id bug ever gets fixed.
        # https://github.com/artemis-sbs/LegendaryMissions/issues/495
        #create_label_value_pair("Mine Detonations", "?")
        create_label_value_pair("Mission Duration (minutes)", str(GAME_STATISTICS.get_duration_in_minutes()), "white")
    
    jump gui_game_end_common
    
# As far as I know, data can't be passed through a label that's
# triggered by calling gui_reroute_client / gui_reroute_server
# (which is what the gui_switch_to function calls)
# So use the label names to communicate the ship number instead.
# Not ideal, but as long as there's no more than 8 player ships,
# it'll work fine.

