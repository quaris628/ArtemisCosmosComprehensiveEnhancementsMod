==== gui_game_end_ship ====
    
    if not ensure_on_gui_task(gui_game_end_main):
        ->END
    
    GAME_STATISTICS = get_game_statistics()
    VESSEL_TYPES_DATA = get_vessel_types_data()
    GAME_SETUP_DATA = get_game_setup_data()
    
    create_skybox_background_on_client(client_id)
    
    create_top_banner(GAME_SETUP_DATA.difficulty, GAME_SETUP_DATA.get_map_display_name())
    
    # ----- tabs -----
    
    gui_create_top_tabs(SHIP_NUMBER, get_game_results_top_tabs(), x_left_px=0, y_top_px=180)
    
    # ----- main section-----
    
    # 216px = 180px from banner + 36px from tabs
    gui_section(style=f"area:0,216px,100,100-61px;")
    
    player_ship_statistics = GAME_STATISTICS.get_player_ship_statistics_by_number(SHIP_NUMBER)
    ship_type = VESSEL_TYPES_DATA.get_ship_type_from_key(player_ship_statistics.ship_type_key)
    
    # ----- left body -----
    
    with gui_sub_section(style=f"padding:10px,10px,5px,5px;background:{color_background()};"):
        gui_row(style="row-height:36px;")
        gui_text(player_ship_statistics.name, style=f"font:gui-4;justify:left;color:{color_text()};")
        
        gui_row(style="row-height:32px;")
        gui_text(ship_type.get_full_name(), style=f"font:gui-3;justify:left;color:{color_text_secondary()};")
        
        gui_row(style="row-height:32px;")
        if player_ship_statistics.was_destroyed:
            gui_text("Destroyed", style=f"font:gui-3;justify:left;color:#f44;")
        else:
            gui_text("Survived", style=f"font:gui-3;justify:left;color:lime;")
    
    # ----- right body -----
    
    with gui_sub_section(style=f"padding:5px,10px,10px,5px;background:{color_background()};"):
        if player_ship_statistics.was_destroyed:
            gui_blank()
        else:
            gui_row(style="row-height:32px;padding:8px,4px,8px,0;")
            # $text is necessary in order to display a colon
            # https://github.com/artemis-sbs/LegendaryMissions/issues/566#issuecomment-4291760757
            gui_text("$text:Remaining Supplies:;", style="font:gui-3;justify:right;color:yellow;")
            
            create_label_value_pair("Energy", f"{player_ship_statistics.remaining_energy:.0f}", "yellow")
            
            ~~
            for ordinance_type, count in player_ship_statistics.remaining_ordinance.items():
                create_label_value_pair(ordinance_type, str(count), "yellow")
            ~~
    
    jump gui_game_end_common

==== gui_game_end_common ====
    
    # ----- bottom text and buttons -----
    
    SETTINGS = settings_get_defaults()
    is_new_game_wo_script_restart_enabled = SETTINGS.get("ENABLE_NEW_GAME_WO_SCRIPT_RESTART", False)
    # TODO this should be 'server OR operator admin client OR (enable_new_game_wo_script_restart AND not locked out from changing my console)'
    make_bottom_right_button = client_id == 0 or is_client_verified_operator_admin() or is_new_game_wo_script_restart_enabled
    
    x_right = "70-20px" if make_bottom_right_button else "100-10px"
    gui_section(style=f"area:10px,100-56px,{x_right},100-10px;background:{color_background()};")
    gui_text("Thanks for playing!\nFind the latest news and version at artemisspaceshipbridge.com", style=f"font:gui-2;padding:5px,0;color:{color_text()};")
    
    if make_bottom_right_button:
        gui_section(style="area:70-10px,100-55px,100-10px,100-10px")
        # Use separate button and text label to work around not
        # being able to "justify:center;" a button's built-in label
        bottom_right_button = gui_button("", style=f"font:gui-3;color:{color_text()}")
        gui_section(style="area:70-10px,100-55px,100-10px,100-10px")
        if client_id == 0 or is_client_verified_operator_admin():
            gui_text("New Game", style=f"font:gui-3;justify:center;color:{color_text()};")
            if is_new_game_wo_script_restart_enabled:
                on gui_message(bottom_right_button):
                    set_up_new_game()
                    gui_switch_to(gui_game_setup_main)
            else:
                on gui_message(bottom_right_button):
                    # TODO: clear guis and show message that the game is restarting (like a loading screen)
                    sbs.run_next_mission(get_mission_name())
        else: # is_new_game_wo_script_restart_enabled == True
            gui_text("Change Console", style=f"font:gui-3;justify:center;color:{color_text()};")
            on gui_message(bottom_right_button):
                # TODO add a "back to game results" button to console selection
                # And make game state "game ended" jump straight to in-progress when
                # starting a second or subsequent game, so the game status can be
                # used to determine whether this button should be enabled.
                gui_switch_to(gui_console_selection_main)
    
    # ----- responding to events -----
    
    signal_register(signal_game_started(), gui_game_end_on_game_started, is_temporary=True)
    
    await gui()

 ==== gui_game_end_on_game_started ====
    GAME_SETUP_DATA = get_game_setup_data()
    # Client will not be ready in the event that the player ship count is decreased
    # lower than the client's previous ship number
    if not GAME_SETUP_DATA.is_client_ready(client_id):
        # TODO maybe notify the player at the time this client becomes not ready
        # due to their selected ship being changed
        gui_switch_to(gui_console_selection_main)
        ->END
    
    jump_into_game()
    
    ->END
